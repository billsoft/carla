@@ -821,6 +822,17 @@ TArray<FSceneView*> SetupViewFamilyForSceneCapture(
 		{
 			// Use CubemapFaceIndex if in range [0..CubeFace_MAX), otherwise use ViewIndex.  Casting to unsigned treats -1 as a large value, choosing ViewIndex.
 			ViewInitOptions.SceneViewStateInterface = SceneCaptureComponent->GetViewState((uint32)CubemapFaceIndex < CubeFace_MAX ? CubemapFaceIndex : ViewIndex + CubemapFaceOffset);
+
+			// CARLA engine patch: use another capture's eye adaptation (SceneCaptureExposureSharing.h), so a camera
+			// made of several captures (cube-map fisheye faces) has one shared auto exposure instead of seams.
+			if (USceneCaptureComponent* ExposureSource = SceneCaptureExposureSharing::GetExposureSource(SceneCaptureComponent))
+			{
+				if (FSceneViewStateInterface* ExposureState = ExposureSource->GetViewState(0))
+				{
+					ViewInitOptions.ExposureSceneViewStateInterface = ExposureState;
+				}
+			}
+
 			ViewInitOptions.LODDistanceFactor = FMath::Clamp(SceneCaptureComponent->LODDistanceFactor, .01f, 100.0f);
 			ViewInitOptions.bIsSceneCaptureCube = SceneCaptureComponent->IsCube();
 			ViewInitOptions.bSceneCaptureUsesRayTracing = GRayTracingSceneCaptures == -1 ? SceneCaptureComponent->bUseRayTracingIfEnabled : GRayTracingSceneCaptures > 0;
